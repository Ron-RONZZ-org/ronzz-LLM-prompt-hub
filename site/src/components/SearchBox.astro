---
const {
  placeholder = 'Search prompts…',
  autofocus = false,
  compact = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Unique per rendered instance so several search boxes can coexist on a page.
const inputId = `search-input-${Math.random().toString(36).slice(2, 9)}`;
---

<div class:list={['search', { 'search-compact': compact }]} data-base={base} data-search>
  <label class="visually-hidden" for={inputId}>Search prompts</label>
  <input
    id={inputId}
    class="search-input"
    type="search"
    name="q"
    placeholder={placeholder}
    autocomplete="off"
    autofocus={autofocus}
  />
  <ul class="search-results" hidden></ul>
  <p class="search-empty" hidden>No prompts match that search.</p>
</div>

<script>
  function initSearch(root) {
    const input = root.querySelector('.search-input');
    const list = root.querySelector('.search-results');
    const empty = root.querySelector('.search-empty');
    const base = root.dataset.base;
    let index = null;
    let pending = null;

    async function loadIndex() {
      if (!index) {
        index = await fetch(`${base}/search-index.json`).then((r) => r.json());
      }
      return index;
    }

    function escapeHtml(value) {
      return value.replace(/[&<>"']/g, (c) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
      ));
    }

    function render(query) {
      const q = query.trim().toLowerCase();
      list.innerHTML = '';
      if (!q) {
        list.hidden = true;
        empty.hidden = true;
        return;
      }
      const titleHits = [];
      const bodyHits = [];
      for (const doc of index) {
        if (doc.title.toLowerCase().includes(q)) titleHits.push(doc);
        else if (doc.text.includes(q)) bodyHits.push(doc);
      }
      const hits = [...titleHits, ...bodyHits].slice(0, 20);
      if (!hits.length) {
        list.hidden = true;
        empty.hidden = false;
        return;
      }
      empty.hidden = true;
      for (const hit of hits) {
        const li = document.createElement('li');
        const crumb = hit.groups.map((g) => g.replace(/[-_]/g, ' ')).join(' › ');
        li.innerHTML = `
          <a href="${base}/prompts/${hit.slug}/">
            <span class="hit-title">${escapeHtml(hit.title)}</span>
            ${crumb ? `<span class="hit-crumb">${escapeHtml(crumb)}</span>` : ''}
            ${hit.kind === 'model' ? '<span class="badge badge-sm">System</span>' : ''}
          </a>`;
        list.appendChild(li);
      }
      list.hidden = false;
    }

    input.addEventListener('input', async () => {
      await loadIndex();
      clearTimeout(pending);
      pending = setTimeout(() => render(input.value), 40);
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        input.value = '';
        render('');
        input.blur();
      }
      if (event.key === 'ArrowDown' && !list.hidden) {
        event.preventDefault();
        list.querySelector('a')?.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target)) {
        list.hidden = true;
        empty.hidden = true;
      }
    });
  }

  document.querySelectorAll('[data-search]').forEach(initSearch);
</script>
