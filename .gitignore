# Node deps (installed into dist/opencode/ by users who symlink ~/.config/opencode)
node_modules/
package-lock.json
bun.lock

# Personal secrets (per-user, never committed — see src/fundamentals/credential-policy.md)
.secrets/

# Python bytecode
__pycache__/

# Built prompt-store site (generated by site/; deployed to GitHub Pages)
_site/

# Keep the site's lockfile so CI can `npm ci` reproducibly
!site/package-lock.json
